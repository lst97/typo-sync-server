{
	"compilerOptions": {
		"lib": ["deno.window"],
		"strict": true
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.13",
		"oak": "https://deno.land/x/oak@v17.1.5/mod.ts",
		"cors": "https://deno.land/x/cors@v1.2.2/mod.ts",
		"@std/fs": "jsr:@std/fs@^1.0.19",
		"@std/path": "jsr:@std/path@^1.1.1",
		"@std/ulid": "jsr:@std/ulid@^1.0.0",
		"@std/http": "jsr:@std/http@^1.0.19",
		"@std/testing": "jsr:@std/testing@^1.0.14",
		"@std/async": "jsr:@std/async@^1.0.13",
		"zod": "https://deno.land/x/zod@v3.25/mod.ts",
		"redis": "https://deno.land/x/redis@v0.40.0/mod.ts",
		"pglite": "npm:@electric-sql/pglite"
	},
	"tasks": {
		"dev": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env --watch main.ts",
		"start": "deno run --allow-net --allow-read --allow-write --allow-run --allow-env main.ts",
		"test": "deno test --allow-net --allow-read --allow-write --allow-run --allow-env",
		"coverage": "deno test --allow-net --allow-read --allow-write --allow-run --allow-env --coverage=coverage",
		"coverage:report": "deno coverage coverage --lcov --output=coverage.lcov"
	},
	"exclude": ["coverage/", "dist/"]
}
