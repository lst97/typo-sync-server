# TypoSync Configuration
# Copy this file to .env and customize for your environment

# API Server Configuration
PORT=8000
LOG_LEVEL=INFO

# Task Management Backend
# Uncomment to enable Redis (for production)
# REDIS_URL=redis://redis:6379/0

# Python Engine Configuration
PYTHON_EXECUTABLE=python3
RHYTHM_ENGINE_PATH=../rhythm_engine/run.py
MIN_NOTE_DURATION=0.05

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes

TURNSTILE_SECRET_KEY=turnstile.secret
DATABASE_URL=./data/typosync.db

# Development Settings (override in .env.dev)
# LOG_LEVEL=DEBUG
# UPLOAD_DIR=/tmp/uploads

#Cache config
CACHE_L1_MAX_SIZE=100
CACHE_L1_TTL_MS=15000
CACHE_L2_TTL_MS=3600000
CACHE_L3_TTL_MS=86400000

#Queue config
QUEUE_CONCURRENCY_LIMIT=2
QUEUE_PROCESSING_TIMEOUT=300000